extends layout

block content
    .w3-card-4
      header.w3-container.w3-blue
          h2
            b= tit
      .w3-container.w3-padding-0
          table.w3-table-all.w3-striped.w3-hoverable.w3-responsive
              tr
                  th.w3-left-align id
                  th.w3-left-align title
                  th.w3-left-align author
                  th.w3-left-align publishDate
                  th.w3-left-align pages
              each c in lbooks
                  tr
                      td 
                          a(href=`/${c._id}`).w3-text-blue= c._id
                      td= c.title
                      td 
                          ul.w3-ul
                              each a in c.author
                                  li= a
                      td= c.publishDate
                      td= c.pages
      footer.w3-container.w3-blue 
          span generated by EngWeb2025 
          a(href='/') voltar
