extends layout

block content
  .w3-card-4
    header.w3-container.w3-blue
        h2
          b= tit
    .w3-container
      table.w3-table-all
        tr
          th ID:
          td= book._id
        tr
          th title:
          td= book.title
        tr
          th series:
          td= book.series
        tr
          th author(s):
          td
            ul.w3-ul
              each a in book.author
                li= a
        tr
          th rating:
          td= book.rating
        tr
          th description:
          td= book.description
        tr
          th language:
          td= book.language
        tr
          th ISBN:
          td= book.isbn
        tr
          th genres:
          td
            ul.w3-ul
              each g in book.genres
                li= g
        tr
          th characters:
          td
            ul.w3-ull
              each c in book.characters
                li= c
        tr
          th format:
          td= book.bookFormat
        tr
          th edition:
          td= book.edition
        tr
          th pages:
          td= book.pages
        tr
          th publisher:
          td= book.publisher
        tr
          th publish date:
          td= book.publishDate
        tr
          th awards:
          td
            ul.w3-ul
              each award in book.awards
                li= award
        tr
          th number of ratings:
          td= book.numRatings
        tr
          th liked percentage:
          td= book.likedPercent + "%"
        tr
          th settings:
          td
            ul.w3-ul
              each s in book.setting
                li= s
        tr
          th cover:
          td
            img(src=book.coverImg, alt="book cover", style="max-width:150px;")
        tr
          th price:
          td= "€" + book.price
    footer.w3-container.w3-blue 
        span generated by EngWeb2025 
        a(href='/') voltar
