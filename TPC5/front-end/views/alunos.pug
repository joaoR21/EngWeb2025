extends layout

block content
  .w3-card-4
    header.w3-container.w3-blue
        h1= tit
    .w3-container
        table.w3-table-all
            tr
                th ID 
                th Nome
                th Gitlink
                th Opções
            each a in lalunos
                tr
                    td= a._id
                    td= a.nome
                    td= a.gitlink
                    td
                        a(href=`/alunos/edit/${a._id}`) Edit
                        |  |  
                        a(href=`/alunos/delete/${a._id}`) Delete
    footer.w3-container.w3-blue 
        span generated by EngWeb2025 
        a(href='/') Voltar
