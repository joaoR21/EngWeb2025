extends layout

block content
    .w3-card-4
        header.w3-container.w3-purple
            h4 editar detalhes de aluno
        
        form.w3-container(method="POST")
            fieldset
                legend dados
                label ID.
                input.w3-input.w3-round(type="text",name="id",required,value=a._id)
                label nome
                input.w3-input.w3-round(type="text",name="nome",required,value=a.nome)
                label gitlink
                input.w3-input.w3-round(type="text",name="gitlink",required,value=a.gitlink)
            
            fieldset
                legend TPCs
                each val, index in [1,2,3,4,5,6,7,8]
                    input.w3-check(type="checkbox",name="tpc" + val,value="1",checked=a.tpcs['tpc' + val] == 1)
                    label TPC#{val}
            
            br
            button.w3-btn.w3-purple.w3-mb-2(type="submit") Guardar alterações
        
        footer.w3-container.w3-blue 
            span generated by EngWeb2025 
            a(href='/') Voltar