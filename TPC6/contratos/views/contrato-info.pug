extends layout

block content
  .w3-card-4
    header.w3-container.w3-blue
        h1= tit
    .w3-container
      table.w3-table-all
        tr
          th ID:
          td= contr._id
        tr
          th no. de anúncio:
          td= contr.nAnuncio
        tr
          th tipo de procedimento:
          td= contr.tipoprocedimento
        tr
          th Objecto do Contrato:
          td= contr.objectoContrato
        tr
          th data de publicação:
          td= contr.dataPublicacao
        tr
          th Data de Celebração:
          td= contr.dataCelebracaoContrato
        tr
          th Preço Contratual:
          td= contr.precoContratual
        tr
          th prazo de execução:
          td= contr.prazoExecucao
        tr
          th NIPC Entidade Comunicante:
          td= contr.NIPC_entidade_comunicante
        tr
          th Entidade Comunicante:
          td= contr.entidade_comunicante
        tr
          th fundamentação:
          td= contr.fundamentacao
    footer.w3-container.w3-blue 
        span generated by EngWeb2025 
        a(href='/') voltar